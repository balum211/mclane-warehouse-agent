# Copy to warehouse_agent/.env (adk web / adk deploy read the .env in the agent folder).

# --- Gemini on Vertex AI (Gemini Enterprise / Agent Engine use Vertex AI) ---
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Agent model (any Gemini model enabled in your project)
WMS_AGENT_MODEL=gemini-3.5-flash
# WMS_SNAPSHOT_MODEL=gemini-3.5-flash
# WMS_AGENT_TEMPERATURE=0.2

# --- Data backend: sqlite (local) | bigquery | alloydb ---
WMS_DB_BACKEND=sqlite
# WMS_SQLITE_PATH=data/wms.db

# BigQuery
WMS_BQ_DATASET=mclane_wms
WMS_BQ_LOCATION=US

# AlloyDB (connector path; leave ALLOYDB_INSTANCE_URI empty to use host/port, e.g. the Auth Proxy)
# ALLOYDB_INSTANCE_URI=projects/PROJECT/locations/us-central1/clusters/wms-cluster/instances/wms-primary
# ALLOYDB_HOST=127.0.0.1
# ALLOYDB_PORT=5432
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=change-me
ALLOYDB_DATABASE=wms

# --- Demo clock: the synthetic data is anchored to 2026-10-27 10:30 ---
WMS_AS_OF_DATE=2026-10-27
WMS_CLOCK=10:30
# Use WMS_CLOCK=real with live data.
