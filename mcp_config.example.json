{
  "mcpServers": {
    "adk-docs-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpdoc",
        "mcpdoc",
        "--urls",
        "AgentDevelopmentKit:https://adk.dev/llms.txt",
        "--transport",
        "stdio"
      ]
    },
    "wms-toolbox": {
      "command": "toolbox",
      "args": ["--tools-file", "/ABSOLUTE/PATH/TO/mclane-warehouse-agent/toolbox/tools.yaml", "--stdio"],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "your-project-id",
        "ALLOYDB_USER": "postgres",
        "ALLOYDB_PASSWORD": "set-me",
        "DB_PASSWORD": "set-me-for-tools.cloudsql.yaml"
      }
    }
  }
}
